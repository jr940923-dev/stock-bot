# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 GitHub에 올라가지 않습니다)
KIS_APPKEY=여기에_앱키
KIS_APPSECRET=여기에_앱시크릿
KIS_CANO=계좌번호_앞8자리
KIS_PRDT=01

# 리포트가 올리는 추천 목록 주소
BOT_PICKS_URL=https://raw.githubusercontent.com/jr940923-dev/stock-bot/main/picks.json

# 휴대폰 알림 (선택). ntfy 앱에서 구독할 주제 이름. 남이 못 맞히게 길게.
BOT_NTFY_TOPIC=

# 1 = 주문을 내지 않고 로그만 (첫 실행은 1로 확인 후 0으로)
BOT_DRY_RUN=1

# 봇이 쓸 최대 달러
BOT_MAX_BUDGET_USD=223
